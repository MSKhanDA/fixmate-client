# BetterAuth (runs inside this Next.js app)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Extra comma-separated origins BetterAuth should trust (e.g. Vercel preview URLs)
TRUSTED_ORIGINS=

# MongoDB (same database as the Express server)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=fixmate

# Must match JWT_SECRET in the server .env
JWT_SECRET=replace-with-a-long-random-string

# ImgBB key (server-side only; used by /api/upload)
IMGBB_API_KEY=

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false
